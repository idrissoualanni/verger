# Variables d'environnement pour l'API Cloudflare Workers (dev)
# Copier ce fichier en .dev.vars et remplir les valeurs

# Environnement
APP_ENV=development

# Base URL de l'API (pour Better Auth)
BETTER_AUTH_URL=http://localhost:8788

# Secret pour signer les sessions Better Auth (générer avec: openssl rand -base64 32)
BETTER_AUTH_SECRET=ton-secret-ici

# URL de la base de données Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/verger

# Clé API pour le dashboard Better Auth Sentinel
BETTER_AUTH_API_KEY=ba_xxxxxxxxxxxxxxxxxxxxx
