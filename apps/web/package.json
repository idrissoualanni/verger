{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && tsx scripts/fix-monorepo-standalone.ts",
    "dev": "next dev",
    "build:cf": "tsx scripts/clean-sharp.ts && npx opennextjs-cloudflare build && tsx scripts/patch-opennext.ts",
    "build:prod": "NODE_ENV=production next build",
    "start": "next start",
    "preview": "tsx scripts/clean-sharp.ts && npx opennextjs-cloudflare build && tsx scripts/patch-opennext.ts && npx opennextjs-cloudflare preview",
    "deploy": "tsx scripts/clean-sharp.ts && npx opennextjs-cloudflare build && tsx scripts/patch-opennext.ts && npx opennextjs-cloudflare deploy",
    "upload": "tsx scripts/clean-sharp.ts && npx opennextjs-cloudflare build && tsx scripts/patch-opennext.ts && npx opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@verger/shared": "workspace:*",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.1",
    "lucide-react": "^1.31.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250701.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  },
  "packageManager": "pnpm@11.10.0"
}