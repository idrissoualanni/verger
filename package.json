{
  "name": "le-verger",
  "private": true,
  "version": "0.1.0",
  "description": "Le Verger — Plateforme de gestion scolaire intégrée (Dakar, Sénégal)",
  "scripts": {
    "dev:web": "pnpm --filter @verger/web dev",
    "dev:api": "pnpm --filter @verger/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @verger/e2e test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
